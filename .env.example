WIDSIGN_API_ID=
WIDSIGN_API_KEY=
NOTION_API_TOKEN=

# ---- 완료 계약 자동 동기화 (src/sync/scheduledCompletionSync.ts) ----

# 실제 "전자계약 관리 DB"의 data_source_id (필수 — 비어 있으면 sync가 아무 것도 하지 않음)
WIDSIGN_SYNC_DATA_SOURCE_ID=

# 아래는 모두 선택 — 비워두면 docs/DATABASE_SCHEMA.md 기본 속성명을 그대로 사용
WIDSIGN_SYNC_SEND_ID_PROPERTY=발송 ID (send_id)
WIDSIGN_SYNC_FORM_ID_PROPERTY=양식 ID (form_id)
WIDSIGN_SYNC_RECEIVER_ID_PROPERTY=수신자 ID
WIDSIGN_SYNC_PROGRESS_STATUS_PROPERTY=진행상태
WIDSIGN_SYNC_PROGRESS_STATUS_COMPLETE_VALUE=완료
WIDSIGN_SYNC_COMPLETED_FILE_PROPERTY=완료 계약서
WIDSIGN_SYNC_SCHEDULE=1h
# 실제로 조회/처리를 실행할 요일(일=0~토=6, 기본 화~토)과 시각(KST, 기본 8시/15시).
# schedule 주기로 깨어나되 이 요일·시각이 아니면 API 호출 없이 바로 종료한다.
WIDSIGN_SYNC_TARGET_DAYS_KST=2,3,4,5,6
WIDSIGN_SYNC_TARGET_HOURS_KST=8,15

# 안전장치 — 반드시 검증 후에만 false/숫자 상향 조정
# true(기본값)면 실제 Notion 수정 없이 로그만 남긴다.
WIDSIGN_DRY_RUN=true
# 한 번의 실행에서 수정 가능한 최대 건수. 초과 시 이번 실행은 아무 것도 수정하지 않는다.
WIDSIGN_MAX_UPDATES_PER_RUN=1
